                    "instagramConnectionLink": {
                      "type": "string",
                      "description": "Link da conexão com o Instagram"
                    }
                  },
                  "required": [
                    "id",
                    "expiresIn",
                    "qrCodeLink",
                    "metaConnectionLink",
                    "instagramConnectionLink"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },

      "post": {
        "summary": "Cria uma tag",
        "tags": [
          "Tags"
        ],
        "description": "Cria uma tag no catálogo do usuário autenticado. O nome é único por usuário, sem diferenciar maiúsculas de minúsculas. A cor deve ser um dos valores da paleta fixa da plataforma.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30,
                    "description": "Nome da tag"
                  },
                  "color": {
                    "type": "string",
                    "enum": [
                      "SLATE",
                      "RED",
                      "ORANGE",
                      "AMBER",
                      "GREEN",
                      "TEAL",
                      "BLUE",
                      "INDIGO",
                      "PURPLE",
                      "PINK"
                    ],
                    "description": "Cor da tag, escolhida da paleta fixa da plataforma"
                  }

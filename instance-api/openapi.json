                            "CPF",
                            "CNPJ"
                          ],
                          "nullable": true
                        },
                        "createdById": {
                          "type": "string",
                          "nullable": true
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "email",
                        "emailVerified",
                        "phone",
                        "phoneVerified",
                        "createdAt",
                        "updatedAt"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "user"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/tags": {
      "get": {
        "summary": "Lista as tags do usuário",
        "tags": [
          "Tags"
        ],
        "description": "Lista todas as tags do usuário autenticado, em ordem alfabética, com a quantidade de instâncias em que cada uma está aplicada. Não é paginado: o catálogo tem limite de 50 tags.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "userId",
            "required": false,
            "description": "Id do usuário selecionado. Aplica-se somente para clientes parceiros com autorização para gerenciar sub-contas na ZapperHub."
          }
        ],
        "security": [
          {
            "token": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "color": {
                            "type": "string",
                            "enum": [
                              "SLATE",
                              "RED",
                              "ORANGE",
                              "AMBER",
                              "GREEN",
                              "TEAL",
                              "BLUE",
                              "INDIGO",
                              "PURPLE",
                              "PINK"

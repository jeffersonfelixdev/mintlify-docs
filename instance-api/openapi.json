                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "instanceId",
            "required": true,
            "description": "Id da instância"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "ID do link de conexão"
                    },
                    "expiresIn": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true,
                      "description": "Data de expiração do link"
                    },
                    "qrCodeLink": {
                      "type": "string",
                      "description": "Link do QR Code"
                    },
                    "metaConnectionLink": {
                      "type": "string",
                      "description": "Link da conexão com a Meta (login com Facebook)"

    "/api/v2/instances/{instanceId}/connection-link": {
      "post": {
        "summary": "Criar link de conexão",
        "tags": [
          "Instâncias"
        ],
        "description": "Cria um novo link de conexão para uma instância",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expiresIn": {
                    "type": "string",

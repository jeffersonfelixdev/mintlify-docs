          "Instâncias"
        ],
        "description": "Obtém todas as instâncias",
        "parameters": [
          {
            "schema": {
              "type": "number",
              "default": 10
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Limite de instâncias por página"
          },
          {
            "schema": {
              "type": "number",
              "default": 1
            },
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Número da página"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "label",
            "required": false,
            "description": "Label da instância"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "label",
                "id",
                "created_at"
